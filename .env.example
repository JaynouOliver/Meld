# Meta Model API (https://dev.meta.ai). Server-only; never prefix with NEXT_PUBLIC_.
MODEL_API_KEY=
# Optional overrides
# MODEL_API_BASE=https://api.meta.ai/v1
# ATLAS_MODEL=muse-spark-1.3          # or muse-wonder-1.0 for heavier orchestration
# ATLAS_REASONING_EFFORT=low          # minimal | low | medium | high | xhigh | max

# Supabase (shared database + realtime). Without these the server keeps data in memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # secret: server only
NEXT_PUBLIC_SUPABASE_URL=           # public: realtime pings only
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # public (publishable key): realtime pings only
